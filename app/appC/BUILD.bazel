load("//tools:defs.bzl", "junit5_test_suite", "tracer_java_binary", "tracer_java_library")

tracer_java_library(
    name = "appC_lib",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = ["//utils", "@maven//:com_google_code_gson_gson"],
)

tracer_java_binary(
    name = "appC",
    main_class = "io.joeyang.tracer.app.c.AppC",
    runtime_deps = [":appC_lib"],
    visibility = ["//visibility:public"],
)

junit5_test_suite(
    name = "tests",
    srcs = glob(["src/test/java/**/*.java"]),
    deps = [":appC_lib"],
)
