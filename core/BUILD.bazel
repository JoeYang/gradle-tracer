load("//tools:defs.bzl", "junit5_test_suite", "tracer_java_library")

tracer_java_library(
    name = "core",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = ["//utils"],  # implementation: not exported
    visibility = ["//:__subpackages__"],
)

junit5_test_suite(
    name = "tests",
    srcs = glob(["src/test/java/**/*.java"]),
    deps = [":core"],
)
