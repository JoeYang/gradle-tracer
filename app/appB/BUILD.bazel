load("//tools:defs.bzl", "junit5_test_suite", "tracer_java_binary", "tracer_java_library")

tracer_java_library(
    name = "appB_lib",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = ["//core"],
)

tracer_java_binary(
    name = "appB",
    main_class = "io.joeyang.tracer.app.b.AppB",
    runtime_deps = [":appB_lib"],
    visibility = ["//visibility:public"],
)

junit5_test_suite(
    name = "tests",
    srcs = glob(["src/test/java/**/*.java"]),
    deps = [":appB_lib"],
)
